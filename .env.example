# Mẫu biến môi trường Windows; KHÔNG commit file .env thật.
# Uvicorn không tự nạp .env. Dùng $env:TEN_BIEN = "gia-tri" trong PowerShell.

# SQLite: đường dẫn tương đối như dưới, tuyệt đối ví dụ sqlite:///C:/BatTrang/data/app.db.
DATABASE_URL=sqlite:///./data/app.db

# Thư mục lưu MP3 do module audio quản lý.
AUDIO_DIR=./audio_files

# Wikimedia yêu cầu User-Agent có thông tin liên hệ. Hãy thay phần trong ngoặc bằng
# email hoặc URL repo thật của nhóm trước khi gọi Wikimedia (Tuần 3).
WIKIMEDIA_USER_AGENT=sgu26-thuyet-minh/0.1 (THAY-BANG-THONG-TIN-LIEN-HE-CUA-NHOM)

# Timeout (giây) theo ngân sách: Wikimedia 8s, TTS 15s, tổng request 25s.
WIKIMEDIA_TIMEOUT_S=8
TTS_TIMEOUT_S=15
REQUEST_TIMEOUT_S=25

LOG_LEVEL=INFO

# URL trang người dùng dùng để tạo QR (không chứa /admin). Để trống sẽ dùng origin request.
# Localhost không dùng được khi quét từ điện thoại. run_lan.ps1 tự đặt URL LAN khi chạy.
# Khi triển khai, thay bằng tên miền HTTPS.
PUBLIC_BASE_URL=
